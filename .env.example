# Chroma Cloud (vector store)
CHROMA_HOST=api.trychroma.com
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=

# Supabase (use the service-role key; it stays on the server)
SUPABASE_URL=
SUPABASE_KEY=

# Groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Google sign-in (also set VITE_GOOGLE_CLIENT_ID in frontend/.env)
GOOGLE_CLIENT_ID=
